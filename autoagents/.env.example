# GitHub + autoagents (optional — copy to .env, never commit)

# Fine-grained PAT with Issues read/write on laravel-ecommerce
# GH_TOKEN=ghp_...

AGENT_GH_REPO=Luipy56/laravel-ecommerce
AGENT_GIT_BRANCH=autoagents

# Ephemeral task dashboard (./autoagents/autoagents-dashboard.sh or loop --dashboard)
# AGENT_DASHBOARD_PORT=8765
# AGENT_PRIMORDIAL_CSS=/home/luipy/Documents/primordial.css
# AGENT_TASKDIR=autoagents/tasks

# Committer: full cursor-agent committer (CHANGELOG + package.json)
AGENT_COMMITTER_USE_CURSOR=1

# Git author for agent commits (must match Luipy GitHub identity — never autoagents-committer)
AGENT_GIT_AUTHOR_NAME=Luipy56
AGENT_GIT_AUTHOR_EMAIL=yoelberjaga@gmail.com

# Runtime digest and gh stderr (inside repo; do not use /tmp)
# AGENT_LOOP_TMP=autoagents/var/loop
